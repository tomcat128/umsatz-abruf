# Konfiguration für docker compose. Kopieren nach ".env" und Werte eintragen:
#   cp .env.example .env && chmod 600 .env
# Die Datei ".env" ist per .gitignore vom Versionieren ausgeschlossen.
# Bedeutung der Werte: siehe fints.properties.example (Schlüssel in Großbuchstaben, "." -> "_").

# --- Bankzugang (Pflicht) ---------------------------------------------------
FINTS_BLZ=12345678
FINTS_BENUTZER=MeinAnmeldename
FINTS_IBAN=DE00123456780000000000

# Kundenkennung, leer = wie Benutzerkennung
FINTS_KUNDENID=

# PIN. Leer lassen = Abfrage beim Start (empfohlen: Umgebungsvariablen eines Containers
# sind per "docker inspect" für jeden mit Docker-Zugriff lesbar).
FINTS_PIN=

# PIN/TAN-Serveradresse, leer = automatisch aus der Bankenliste von HBCI4Java
FINTS_URL=

# Eigene FinTS-Produktregistrierung, leer = Test-Registrierung von HBCI4Java
FINTS_PRODUKTID=

# --- TAN ------------------------------------------------------------------
# Code des TAN-Verfahrens, z.B. 921 = pushTAN 2.0. Leer = Auswahl beim Start.
FINTS_TANVERFAHREN=
FINTS_TANMEDIUM=

# --- Passport-Datei ---------------------------------------------------------
# Passwort der verschlüsselten Passport-Datei (daten/umsatz-abruf.passport).
# Leer = Abfrage beim Start.
PASSPORT_PASSWORT=

# --- Abruf ------------------------------------------------------------------
# Anzahl vergangener Tage
ABRUF_TAGE=7
# Zeitplan im Serverbetrieb (Spring-Cron: Sekunde Minute Stunde Tag Monat Wochentag).
# Leer = täglich 6 Uhr, "-" = kein automatischer Abruf
ABRUF_ZEITPLAN=
# Optional fester Zeitraum (JJJJ-MM-TT); ABRUF_VON hat Vorrang vor ABRUF_TAGE
ABRUF_VON=
ABRUF_BIS=
# auto, camt oder mt940
ABRUF_FORMAT=auto

# --- Weboberfläche (Serverbetrieb) ---------------------------------------------
# Der einzige Benutzer. Passwort mindestens 12 Zeichen oder als Hash, z.B. {bcrypt}$2a$10$...
# (in .env dann jedes $ als $$ schreiben)
WEB_BENUTZER=
WEB_PASSWORT=
# Öffentliche Adresse für Links in E-Mails, z.B. https://umsatz.example.org
WEB_ADRESSE=
# Wie lange auf Eingaben/Freigaben gewartet wird (Minuten), Standard 10
WEB_WARTEZEIT=
# Port auf dem Host (nur 127.0.0.1), Standard 8080
#WEB_PORT=8080
# Für HTTPS von unterwegs (docker-compose.https.yml): Domain dieses Servers
#WEB_DOMAIN=umsatz.example.org
# Compose-Dateien, die "docker compose" ohne -f verwendet, z.B.
#COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml:docker-compose.mariadb.yml

# --- Ausgabe ----------------------------------------------------------------
# csv, datenbank oder beide. Leer bzw. auskommentiert = csv,
# mit docker-compose.mariadb.yml = datenbank
#AUSGABE_ZIEL=beide

# --- Datenbank ----------------------------------------------------------------
# Für den MariaDB-Container (docker-compose.mariadb.yml) genügt DB_PASSWORT,
# es wird beim ersten Start für den Datenbankbenutzer festgelegt.
DB_PASSWORT=
# Optional: Name von Datenbank und Benutzer, Port für Zugriff vom Host (nur localhost)
#DB_NAME=umsaetze
#DB_BENUTZER=umsatz
#DB_HOST_PORT=3307
# Nur für eine externe Datenbank (ohne docker-compose.mariadb.yml), z.B.
#DB_URL=jdbc:mariadb://datenbank.example:3306/umsaetze

# --- E-Mail-Benachrichtigung (optional) ----------------------------------------
# E-Mail, sobald die Bank eine Freigabe (pushTAN usw.) anfordert. Aktiv, sobald
# MAIL_EMPFAENGER gesetzt ist (mehrere mit Komma trennen).
# Test: docker compose run --rm umsatz-abruf --mail-test
MAIL_EMPFAENGER=
MAIL_HOST=
# starttls (Standard, Port 587), ssl (Port 465) oder keine (Port 25)
MAIL_SICHERHEIT=starttls
MAIL_PORT=
MAIL_BENUTZER=
MAIL_PASSWORT=
# Standard: MAIL_BENUTZER
MAIL_ABSENDER=

# --- Sonstiges --------------------------------------------------------------
# 0=aus ... 5=Trace. Ab 4 werden Bankdaten im Klartext protokolliert!
LOG_LEVEL=2
TZ=Europe/Berlin
