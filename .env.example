# Konfiguration für docker compose. Kopieren nach ".env" und Werte eintragen:
#   cp .env.example .env && chmod 600 .env
# Die Datei ".env" ist per .gitignore vom Versionieren ausgeschlossen.
# Bedeutung der Werte: siehe fints.properties.example (Schlüssel in Großbuchstaben, "." -> "_").

# --- Bankzugang (Pflicht) ---------------------------------------------------
FINTS_BLZ=12345678
FINTS_BENUTZER=MeinAnmeldename
FINTS_IBAN=DE00123456780000000000
# Kundenkennung, leer = wie Benutzerkennung
FINTS_KUNDENID=
# Eigene FinTS-Produktregistrierung, leer = Test-Registrierung von HBCI4Java
FINTS_PRODUKTID=
# PIN/TAN-Serveradresse, leer = automatisch aus der Bankenliste von HBCI4Java
FINTS_URL=

# PIN. Damit die automatischen Abrufe ohne Eingabe durchlaufen, setzen. Leer = jeder Abruf
# wartet auf die Eingabe im Browser (und setzt die Abrufe aus, wenn sie ausbleibt).
# Die Passport-Datei samt Passwort verwaltet die Anwendung selbst - dafür ist nichts einzutragen.
FINTS_PIN=

# Code des TAN-Verfahrens, z.B. 921 = pushTAN 2.0. Leer = Auswahl im Browser.
FINTS_TANVERFAHREN=
FINTS_TANMEDIUM=

# --- Abruf ------------------------------------------------------------------
# Abstand zwischen zwei Abrufen, z.B. 6h, 30m, 1d (mindestens 15m). "aus" = nur per Knopf.
ABRUF_INTERVALL=6h
# Anzahl vergangener Tage je Abruf
ABRUF_TAGE=7
# datenbank (Standard), csv oder beide
#AUSGABE_ZIEL=datenbank

# --- Export-Schnittstelle -------------------------------------------------------
# /api/buchungen.csv, .json, .xml für externe Anwendungen. ACHTUNG: vorerst OHNE Anmeldung -
# jeder, der die Adresse erreicht, kann alle Buchungen abrufen. false = abgeschaltet.
EXPORT_AKTIV=true

# --- Weboberfläche ------------------------------------------------------------
# Domain, unter der Caddy die Anwendung per HTTPS ausliefert, z.B. umsatz.example.org.
# "localhost" zum Ausprobieren (Caddy nutzt dann ein lokales Zertifikat).
WEB_DOMAIN=localhost
# Der einzige Benutzer. Passwort mindestens 12 Zeichen oder als Hash, z.B. {bcrypt}$$2a$$10$$...
# (Hash erzeugen: docker compose run --rm umsatz-abruf passwort-hash - in .env jedes $ als $$)
WEB_BENUTZER=
WEB_PASSWORT=
# Wie lange auf Eingaben/Freigaben gewartet wird (Minuten), bevor die Abrufe ausgesetzt werden
WEB_WARTEZEIT=10
# Öffentliche Adresse für Links in E-Mails, Standard: https://<WEB_DOMAIN>
#WEB_ADRESSE=

# Ports von Caddy auf dem Host, falls 80/443 belegt sind
#HTTP_PORT=80
#HTTPS_PORT=443

# --- Notfall-E-Mail -------------------------------------------------------------
# Unvollständige Angaben verhindern den Start nicht - die Weboberfläche zeigt, was fehlt,
# und bietet einen Knopf für eine Test-E-Mail.
# An diese Adresse(n) geht eine E-Mail, wenn die Bank eine Freigabe anfordert und wenn die
# Abrufe wegen fehlender Autorisierung ausgesetzt werden (mehrere mit Komma trennen).
MAIL_NOTFALL=
MAIL_HOST=
# starttls (Standard, Port 587), ssl (Port 465) oder keine (Port 25)
MAIL_SICHERHEIT=starttls
MAIL_PORT=
MAIL_BENUTZER=
MAIL_PASSWORT=
# Standard: MAIL_BENUTZER
MAIL_ABSENDER=

# --- Sonstiges --------------------------------------------------------------
# Datenverzeichnis auf dem Host (Datenbank, Passport-Datei, Status)
#DATEN_VERZEICHNIS=./daten
# 0=aus ... 5=Trace. Ab 4 werden Bankdaten im Klartext protokolliert!
LOG_LEVEL=2
TZ=Europe/Berlin
