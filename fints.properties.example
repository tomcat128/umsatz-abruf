# Vorlage für die Konfiguration des Umsatz-Abrufs.
# Kopieren nach "fints.properties" und Werte eintragen:
#   cp fints.properties.example fints.properties && chmod 600 fints.properties
# Die Datei "fints.properties" ist per .gitignore vom Versionieren ausgeschlossen.
#
# Jeder Wert kann auch per Umgebungsvariable gesetzt werden (hat Vorrang vor der Datei):
# Großbuchstaben, "." wird "_", z.B. abruf.tage -> ABRUF_TAGE. Ohne diese Datei genügen
# die Umgebungsvariablen (z.B. im Docker-Container, siehe docker-compose.yml).

# --- Bankzugang (Pflicht) ---------------------------------------------------
fints.blz=12345678
fints.benutzer=MeinAnmeldename
fints.iban=DE00 1234 5678 0000 0000 00

# Kundenkennung - meist identisch mit der Benutzerkennung (Standard)
#fints.kundenid=

# PIN. Leer = Abfrage im Browser bei jedem Abruf - für automatische Abrufe daher setzen.
# Alternativ per Umgebungsvariable FINTS_PIN.
fints.pin=

# PIN/TAN-Serveradresse. Leer = automatisch aus der Bankenliste von HBCI4Java.
#fints.url=https://fints.meine-bank.example/fints30

# Eigene FinTS-Produktregistrierung (kostenlos: https://www.fints.org/de/hersteller/produktregistrierung).
# Leer = Test-Registrierung von HBCI4Java, die nur für Tests gedacht ist und jederzeit ungültig werden kann.
#fints.produktid=

# --- TAN ------------------------------------------------------------------
# Code des TAN-Verfahrens, z.B. 921 = pushTAN 2.0 (Sparkasse). Leer = Auswahl im Browser.
#fints.tanverfahren=921
# Name des TAN-Mediums (z.B. Gerätename), nur nötig bei mehreren Geräten.
#fints.tanmedium=

# --- Passport-Datei ---------------------------------------------------------
# Die Passport-Datei speichert verschlüsselt die Bankparameter und die System-ID, an der die
# Bank dieses System wiedererkennt. Die Anwendung verwaltet sie samt Passwort selbst im
# internen Verzeichnis (im Container ein eigenes Volume) - normalerweise ist hier nichts
# einzutragen. Nur bei Bedarf:
#intern.verzeichnis=/var/lib/umsatz-abruf
#passport.passwort=

# --- Abruf ------------------------------------------------------------------
# Abstand zwischen zwei automatischen Abrufen, z.B. 6h, 30m, 1d (mindestens 15m).
# Der erste Abruf startet eine Minute nach dem Start. "aus" = nur per Knopf im Browser.
abruf.intervall=6h

# Wie viele Tage in die Vergangenheit abgerufen wird. Standard: 7.
# Hinweis: Für Umsätze älter als 90 Tage verlangen viele Banken eine TAN.
abruf.tage=7
# Optional fester Zeitraum im Format JJJJ-MM-TT, z.B. zum einmaligen Nachholen.
# abruf.von hat Vorrang vor abruf.tage; abruf.bis ist standardmäßig heute.
#abruf.von=2026-01-01
#abruf.bis=2026-10-31

# auto (CAMT, falls die Bank es anbietet, sonst MT940), camt oder mt940
# Das Format möglichst nicht wechseln: Die Banken liefern Texte in CAMT und MT940
# teils unterschiedlich, dann würden Buchungen doppelt gespeichert.
abruf.format=auto

# --- Speicher ---------------------------------------------------------------
# datenbank (Standard), csv oder beide
ausgabe.ziel=datenbank

# SQLite-Datei mit allen Buchungen. Relative Pfade beziehen sich auf das Arbeitsverzeichnis
# (im Container: /data, also auf dem Host im gemounteten Datenverzeichnis).
db.datei=umsaetze.db

# CSV-Datei (Semikolon, UTF-8), nur bei ausgabe.ziel=csv oder beide.
#ausgabe.datei=umsaetze.csv

# --- Weboberfläche ------------------------------------------------------------
# Es gibt genau einen Benutzer (Pflicht). Das Passwort mindestens 12 Zeichen lang oder als
# Hash mit Präfix, z.B. {bcrypt}$2a$10$... (java -jar umsatz-abruf.jar passwort-hash).
#web.benutzer=
#web.passwort=
# Öffentliche Adresse der Weboberfläche - wird in den E-Mails verlinkt
#web.adresse=https://umsatz.example.org
# Wie lange auf eine Eingabe oder Freigabe gewartet wird (Minuten). Erfolgt sie nicht,
# werden die automatischen Abrufe ausgesetzt, bis im Browser erneut autorisiert wurde.
#web.wartezeit=10

# --- Notfall-E-Mail (empfohlen) --------------------------------------------------
# An diese Adresse(n) geht eine E-Mail, wenn die Bank eine Freigabe anfordert und wenn die
# Abrufe wegen fehlender Autorisierung ausgesetzt werden. Mehrere mit Komma trennen.
# Test: Knopf "Test-E-Mail senden" in der Weboberfläche.
#mail.notfall=ich@example.org
#mail.host=smtp.example.org
# starttls (Standard, Port 587), ssl (Port 465) oder keine (Port 25, nur im lokalen Netz)
#mail.sicherheit=starttls
#mail.port=587
#mail.benutzer=absender@example.org
# Alternativ per Umgebungsvariable MAIL_PASSWORT
#mail.passwort=
# Absender, Standard: mail.benutzer
#mail.absender=

# Log-Level von HBCI4Java (0=aus, 1=Fehler, 2=Warnungen, 3=Info, 4=Debug, 5=Trace).
# Ab 4 werden Bankdaten im Klartext protokolliert!
log.level=2
